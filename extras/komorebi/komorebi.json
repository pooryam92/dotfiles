{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "app_specific_configuration_path": "$Env:USERPROFILE/applications.json",
  "object_name_change_applications": [
    { "kind": "Exe", "id": "SSMS.exe", "matching_strategy": "Equals" }
  ],
  "cross_monitor_move_behaviour": "Insert",
  "mouse_follows_focus": false,
  "default_workspace_padding": 4,
  "default_container_padding": 4,
  "animation": { "enabled": true, "duration": 150, "style": "EaseOutCubic" },
  "border_width": 4,
  "border_colours": {
    "single": "#7fc8ff",
    "stack": "#e0af68",
    "unfocused": "#505050"
  },
  "stackbar": {
    "mode": "OnStack",
    "label": "Title",
    "tabs": { "background": "#202020", "focused_text": "#e0af68", "unfocused_text": "#a0a0a0" }
  },
  "layout_defaults": {
    "Scrolling": { "layout_options": { "scrolling": { "columns": 1 } } }
  },
  "monitors": [
    {
      "work_area_offset": { "left": 344, "top": 0, "right": 688, "bottom": 0 },
      "workspaces": [
        { "name": "N1", "layout": "Scrolling" },
        { "name": "N2", "layout": "Scrolling" },
        { "name": "N3", "layout": "Scrolling" },
        { "name": "N4", "layout": "Scrolling" },
        { "name": "N5", "layout": "Scrolling" },
        { "name": "N6", "layout": "Scrolling" },
        { "name": "N7", "layout": "Scrolling" },
        { "name": "N8", "layout": "Scrolling" },
        { "name": "N9", "layout": "Scrolling" }
      ]
    },
    {
      "work_area_offset": { "left": 344, "top": 0, "right": 688, "bottom": 0 },
      "workspaces": [
        { "name": "M1", "layout": "Scrolling" },
        { "name": "M2", "layout": "Scrolling" },
        { "name": "M3", "layout": "Scrolling" },
        { "name": "M4", "layout": "Scrolling" },
        { "name": "M5", "layout": "Scrolling" },
        { "name": "M6", "layout": "Scrolling" },
        { "name": "M7", "layout": "Scrolling" },
        { "name": "M8", "layout": "Scrolling" },
        { "name": "M9", "layout": "Scrolling" }
      ]
    },
    {
      "work_area_offset": { "left": 344, "top": 0, "right": 688, "bottom": 0 },
      "workspaces": [
        { "name": "O1", "layout": "Scrolling" },
        { "name": "O2", "layout": "Scrolling" },
        { "name": "O3", "layout": "Scrolling" },
        { "name": "O4", "layout": "Scrolling" },
        { "name": "O5", "layout": "Scrolling" },
        { "name": "O6", "layout": "Scrolling" },
        { "name": "O7", "layout": "Scrolling" },
        { "name": "O8", "layout": "Scrolling" },
        { "name": "O9", "layout": "Scrolling" }
      ]
    }
  ]
}
