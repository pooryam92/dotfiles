// VS Code settings, shared across Linux and Windows.
// Docs: https://code.visualstudio.com/docs/getstarted/settings
//
// Copied, not symlinked, by the installers to:
//   Linux:    ~/.config/Code/User/settings.json
//   Windows:  %APPDATA%\Code\User\settings.json
// Editing this file therefore does not affect a running VS Code; re-run the
// installer, which backs up and replaces the live file. Machine-specific state
// belongs in the live file, not here.
{
  // ==== Markdown: open rendered, not source ====
  // Ctrl+Shift+V is the way back to the source; Ctrl+K V opens a side preview.
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor"
  },

  // ==== Editing model: Vim ====
  // VSCodeVim, installed by the install script.

  "vim.leader": "<space>",

  "vim.useSystemClipboard": true,

  "vim.hlsearch": true,

  "vim.highlightedyank.enable": true,

  // ---- Normal-mode maps ----
  "vim.normalModeKeyBindingsNonRecursive": [
    // --- Split navigation ---
    { "before": ["<C-h>"], "commands": ["workbench.action.navigateLeft"] },
    { "before": ["<C-l>"], "commands": ["workbench.action.navigateRight"] },
    { "before": ["<C-j>"], "commands": ["workbench.action.navigateDown"] },
    { "before": ["<C-k>"], "commands": ["workbench.action.navigateUp"] },

    // --- Code navigation (bare `g`) ---
    { "before": ["g", "d"], "commands": ["editor.action.revealDefinition"] },
    { "before": ["g", "D"], "commands": ["editor.action.revealDeclaration"] },
    { "before": ["g", "i"], "commands": ["editor.action.goToImplementation"] },
    { "before": ["g", "y"], "commands": ["editor.action.goToTypeDefinition"] },
    { "before": ["g", "r"], "commands": ["references-view.findReferences"] },
    { "before": ["g", "a"], "commands": ["editor.action.quickFix"] },
    { "before": ["g", "R"], "commands": ["editor.action.rename"] },

    // --- Leader: navigation ---
    { "before": ["<leader>", "<space>"], "commands": ["workbench.action.quickOpen"] },
    { "before": ["<leader>", "/"], "commands": ["workbench.action.findInFiles"] },
    { "before": ["<leader>", "e"], "commands": ["workbench.view.explorer"] },
    { "before": ["<leader>", "n", "h"], "commands": [":nohl"] },
    { "before": ["<leader>", "-"], "commands": ["workbench.action.splitEditorDown"] },
    { "before": ["<leader>", "|"], "commands": ["workbench.action.splitEditor"] },

    // ---- Leader namespace ----
    //   f Files  g Git  c Code  m Make/Run  t Tests/Terminal  s Settings/Search  a AI
    // Not ported, no VS Code equivalent: <leader>sr, <leader>sc, <leader>st, <leader>ep.

    // --- f: Files ---
    { "before": ["<leader>", "f", "r"], "commands": ["workbench.action.showAllEditorsByMostRecentlyUsed"] },
    { "before": ["<leader>", "f", "n"], "commands": ["explorer.newFile"] },
    { "before": ["<leader>", "f", "c"], "commands": ["workbench.action.openSettingsJson"] },

    // --- g: Git ---
    { "before": ["<leader>", "g", "s"], "commands": ["workbench.view.scm"] },
    { "before": ["<leader>", "g", "b"], "commands": ["git.checkout"] },
    { "before": ["<leader>", "g", "c"], "commands": ["git.commit"] },
    { "before": ["<leader>", "g", "B"], "commands": ["git.blame.toggleEditorDecoration"] },
    { "before": ["<leader>", "g", "h"], "commands": ["timeline.focus"] },
    { "before": ["<leader>", "g", "p"], "commands": ["git.pull"] },
    { "before": ["<leader>", "g", "P"], "commands": ["git.push"] },
    // No default keybindings ship for the worktree commands, so w/W/n were free.
    { "before": ["<leader>", "g", "w"], "commands": ["git.openWorktree"] },
    { "before": ["<leader>", "g", "W"], "commands": ["git.openWorktreeInNewWindow"] },
    { "before": ["<leader>", "g", "n"], "commands": ["git.createWorktree"] },

    // --- c: Code / Refactor ---
    { "before": ["<leader>", "c", "r"], "commands": ["editor.action.rename"] },
    { "before": ["<leader>", "c", "a"], "commands": ["editor.action.quickFix"] },
    { "before": ["<leader>", "c", "f"], "commands": ["editor.action.formatDocument"] },
    { "before": ["<leader>", "c", "o"], "commands": ["editor.action.organizeImports"] },

    // --- m: Make / Run / Debug ---
    { "before": ["<leader>", "m", "r"], "commands": ["workbench.action.debug.run"] },
    { "before": ["<leader>", "m", "d"], "commands": ["workbench.action.debug.start"] },
    { "before": ["<leader>", "m", "s"], "commands": ["workbench.action.debug.stop"] },
    { "before": ["<leader>", "m", "b"], "commands": ["editor.debug.action.toggleBreakpoint"] },
    { "before": ["<leader>", "m", "c"], "commands": ["workbench.action.debug.selectandstart"] },

    // --- t: Tests / Terminal ---
    { "before": ["<leader>", "t", "r"], "commands": ["testing.runCurrentFile"] },
    { "before": ["<leader>", "t", "f"], "commands": ["testing.reRunFailTests"] },
    { "before": ["<leader>", "t", "l"], "commands": ["testing.reRunLastRun"] },
    { "before": ["<leader>", "t", "t"], "commands": ["workbench.action.terminal.toggleTerminal"] },

    // --- s: Settings / Search / Symbols ---
    { "before": ["<leader>", "s", "o"], "commands": ["workbench.action.openSettings"] },
    { "before": ["<leader>", "s", "a"], "commands": ["workbench.action.showCommands"] },
    { "before": ["<leader>", "s", "s"], "commands": ["workbench.action.showAllSymbols"] },
    { "before": ["<leader>", "s", "f"], "commands": ["workbench.action.gotoSymbol"] },

    // --- a: AI ---
    // The Claude extension's own Cmd/Ctrl+Escape focus chord never arrives on Windows.
    { "before": ["<leader>", "a"], "commands": ["claude-vscode.editor.openLast"] }
  ],

  // ==== Git worktrees ====
  // Built into VS Code's git extension but shipped off; this switch lists
  // worktrees as repositories in Source Control.
  "git.detectWorktrees": true,

  // Gitignored files copied into a new worktree, since `git worktree add`
  // materialises only tracked files. Small machine-local files only.
  "git.worktreeIncludeFiles": [".env", ".env.local"],

  // ==== Theme ====
  // Built in, so nothing to install. Not Tokyo Night like the rest of the stack:
  // it reads too dark in full IDE chrome. Ctrl+K Ctrl+T lists what is installed.
  "workbench.colorTheme": "Dark Modern",

  // ==== Font: the JetBrainsMono Nerd Font the installers install ====
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', monospace",
  "editor.fontSize": 14,
  "editor.fontLigatures": true,
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",

  // ==== Editor behaviour ====
  "editor.cursorSurroundingLines": 10,

  "editor.renderWhitespace": "trailing",

  "editor.formatOnSave": false,

  // Minimap is mouse affordance and costs horizontal space.
  "editor.minimap.enabled": false,

  // ==== On-save hygiene ====
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // ==== Markdown source ====
  "[markdown]": {
    // On for prose only; for code the horizontal scroll signals a long line.
    "editor.wordWrap": "on",
    // Two trailing spaces are a hard line break in Markdown, so trimming them
    // reflows paragraphs. Overrides the global setting above.
    "files.trimTrailingWhitespace": false
  },

  // ==== Integrated terminal ====
  // The "PowerShell" profile is pwsh 7; "Windows PowerShell" is the old 5.1.
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.defaultProfile.linux": "zsh"
}
