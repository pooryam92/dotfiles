// VS Code keybindings, shared across Linux and Windows.
// Docs: https://code.visualstudio.com/docs/getstarted/keybindings
//
// Linked to:  Linux ~/.config/Code/User/keybindings.json
//             Windows %APPDATA%\Code\User\keybindings.json
//
// Alt chords never reach VSCodeVim (it only receives the keys it registers in
// its own package.json, none of them alt+<letter>), so alt maps live here and
// not in settings.json. User keybindings here beat extension-contributed ones.
[
  {
    // markdownPreviewFocus is true only in the preview pane, so this adds the
    // return trip and makes Ctrl+Shift+V a two-way toggle.
    "key": "ctrl+shift+v",
    "command": "markdown.showSource",
    "when": "markdownPreviewFocus"
  },

  // --- Move the current line up/down ---
  {
    "key": "alt+k",
    "command": "editor.action.moveLinesUpAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "alt+j",
    "command": "editor.action.moveLinesDownAction",
    "when": "editorTextFocus && !editorReadonly"
  },

  // --- Claude Code: insert an @-mention file reference ---
  // Moved off plain alt+k, which collides with the move-line binding above.
  {
    "key": "alt+shift+k",
    "command": "claude-vscode.insertAtMention",
    "when": "editorTextFocus"
  }
]
