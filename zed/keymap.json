// Zed keymap, shared across Linux and Windows.
// Docs: https://zed.dev/docs/key-bindings
//
// Linked to:  Linux ~/.config/zed/keymap.json  ·  Windows %APPDATA%\Zed\keymap.json
//
// Adds to Zed's built-in bindings; it does not replace them.
[
  {
    // --- Split navigation ---
    // VimControl = any vim mode but insert; !menu yields the keys to a popup menu.
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      // Rebinds Zed's default `gi` (insert at last insert position).
      "g i": "editor::GoToImplementation"
    }
  },
  {
    // --- Code navigation ---
    // Bare `gr` shadows Zed's default `grn` (rename) and `gra` (code action);
    // those stay reachable on `space r` and `space a` / `g .`.
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "g i": "editor::GoToImplementation",
      "g r": "editor::FindAllReferences"
    }
  }
]
